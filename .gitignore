# Build artifacts
bin/
obj/
*.user

# IDE
.vs/
.idea/
*.sln.iml

# Plugin's compile-time references
# - Assembly-CSharp.dll: publicized STUB of the game's assembly (method
#   signatures only, no IL bodies). Committed so CI can build.
# Regenerate after game updates via:
#   assembly-publicizer --strip <game>/Assembly-CSharp.dll -o VGShipyardDiscountFix/lib/Assembly-CSharp.dll
# --strip is REQUIRED: it replaces every method body with `throw null;` so the
# committed DLL carries only type metadata — no game logic. Running the tool
# WITHOUT --strip leaves the full proprietary IL intact, which we can't
# legally redistribute.
VGShipyardDiscountFix/lib/*.dll
VGShipyardDiscountFix/lib/*.pdb
!VGShipyardDiscountFix/lib/Assembly-CSharp.dll

# Local overrides
*.local

# Claude Code runtime state
.claude/

# Release staging artifacts produced by the release workflow
dist/
